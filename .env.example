# 生成随机值：openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-random-secret
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-different-random-secret
# 必须与浏览器访问域名完全一致，包含 https://，不要带路径
KC_HOSTNAME=https://id.example.com
# 默认仅本机访问，交由宿主机 Nginx/宝塔代理
BIND_ADDRESS=127.0.0.1
KC_PORT=8080
